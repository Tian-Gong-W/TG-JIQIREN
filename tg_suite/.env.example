# Runtime environment: development or production
TG_ENV=production

# Generate long random values; never commit the real values.
TG_ADMIN_API_KEY=replace-with-a-long-random-admin-key
TG_OPERATOR_API_KEY=replace-with-a-long-random-operator-key

# Telegram application credentials from https://my.telegram.org
TG_API_ID=replace-with-telegram-api-id
TG_API_HASH=replace-with-telegram-api-hash

# Only for isolated local development; must remain false/unset in production.
TG_AUTH_DISABLED=false

# Optional database path. Keep the database outside the Git working tree when possible.
# TG_DB_PATH=/secure/path/tg_data.db

# Session archive safety limits
TG_MAX_SESSION_UPLOAD_BYTES=209715200
TG_MAX_SESSION_ZIP_MEMBERS=2000
TG_MAX_SESSION_EXTRACTED_BYTES=536870912
